    {
      "name": "Admin book CRUD (set adminEmail and adminPassword first)",
      "item": [
        {
          "name": "POST admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrator can sign in to receive a Sanctum token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "    pm.expect(pm.response.json().data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('adminToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST invalid book returns 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid book is rejected with a standard validation error', function () {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().success).to.eql(false);",
                  "    pm.expect(pm.response.json().message).to.eql('Validation failed');",
                  "    pm.expect(pm.response.json().errors.title).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{createdBookTitle}}\",\n  \"author\": \"Postman\",\n  \"genre\": \"Testing\",\n  \"description\": \"Buku yang dibuat oleh Postman untuk pengujian CRUD.\",\n  \"price\": 50000,\n  \"stock\": 3,\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('createdBookTitle', 'Postman Test ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid book is saved and returns HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json()).to.include({ success: true, message: 'Resource created successfully' });",
                  "    pm.expect(pm.response.json().data.title).to.eql(pm.collectionVariables.get('createdBookTitle'));",
                  "    pm.expect(pm.response.json().data.author).to.eql('Postman');",
                  "    pm.expect(pm.response.json().data.price).to.eql(50000);",
                  "    pm.expect(pm.response.json().data.id).to.exist;",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('createdBookId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET created book",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books/{{createdBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created book can be read back from the database', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('createdBookId')));",
                  "    pm.expect(pm.response.json().data.title).to.eql(pm.collectionVariables.get('createdBookTitle'));",
                  "});"
                ]
              }
            }
          ]
        },
