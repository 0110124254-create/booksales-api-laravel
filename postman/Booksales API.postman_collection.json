        "url": "{{baseUrl}}/books/{{missingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing book returns the standard 404 response', function () {",
              "    pm.response.to.have.status(404);",
              "    pm.expect(pm.response.json()).to.include({ success: false, message: 'Resource not found' });",
              "});"
