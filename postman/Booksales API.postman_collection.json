    {
      "name": "POST invalid checkout returns 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/checkout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid checkout is rejected with validation errors', function () {",
              "    pm.response.to.have.status(422);",
              "    pm.expect(pm.response.json().success).to.eql(false);",
              "    pm.expect(pm.response.json().message).to.eql('Validation failed');",
              "    pm.expect(pm.response.json().errors).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
