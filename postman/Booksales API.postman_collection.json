        ],
        "url": "{{baseUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API root returns JSON success', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.include({ success: true, message: 'Get All Resource' });",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
