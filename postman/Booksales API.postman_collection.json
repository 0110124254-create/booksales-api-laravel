            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books/{{createdBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Book stock is updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.stock).to.eql(7);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE created book",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/books/{{createdBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created test book can be safely deleted', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.include({ success: true, message: 'Resource deleted successfully' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET deleted book returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books/{{createdBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted book can no longer be retrieved', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json()).to.include({ success: false, message: 'Resource not found' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST admin logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrator can revoke the test Sanctum token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.include({ success: true, message: 'Logged out successfully' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
